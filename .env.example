# GPU ID as reported by nvidia-smi. Use "all" to expose all GPUs.
GPU_ID=0

# Change this only when the GPU/driver requires another CUDA/PyTorch build.
PYTORCH_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

TORCH_CACHE_DIR=./.cache/torch

SEED=42
VAL_RATIO=0.10
TEST_RATIO=0.10
EPOCHS=20
BATCH_SIZE=2
WORKERS=4
LEARNING_RATE=0.005

# The source dataset is highly imbalanced (346 motorcycle images vs 9882 car
# images). This sampling weight improves motorcycle exposure without copying it.
MOTORCYCLE_WEIGHT=8.0
